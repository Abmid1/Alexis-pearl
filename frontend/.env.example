# Backend URL used by the browser (baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Backend URL used by server-side rendering (optional; defaults to NEXT_PUBLIC_API_URL)
API_URL=

# Public origin used in sitemaps, e.g. https://app.biltafrica.com (optional; defaults to the request origin)
NEXT_PUBLIC_SITE_URL=

# Optional subdomain routing: with ROOT_DOMAIN=biltafrica.com and wildcard DNS (*.biltafrica.com → Vercel),
# abcproperties.biltafrica.com serves /s/abcproperties. Leave empty to use path links only (/s/<slug>).
NEXT_PUBLIC_ROOT_DOMAIN=
