# ── Required ────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=            # service_role key — server only, never put it in the frontend
JWT_SECRET=                      # long random string; the server refuses to start without it when NODE_ENV=production
PORT=5000
NODE_ENV=development             # set to production on Render (hides internal error details, disables simulated payments)

# ── AI (optional — rule-based fallbacks without it) ─────────
GEMINI_API_KEY=

# ── WhatsApp Business (optional — outbox records "simulated" until set) ─
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=        # also store it on the company row (companies.whatsapp_phone_number_id) to route inbound messages
WHATSAPP_VERIFY_TOKEN=           # required for Meta webhook verification (no default any more)
WHATSAPP_APP_SECRET=             # when set, inbound webhooks must carry a valid X-Hub-Signature-256
DEFAULT_COMPANY_SLUG=            # fallback company for inbound WhatsApp when the number isn't mapped

# ── Payments (optional) ─────────────────────────────────────
PAYSTACK_SECRET_KEY=             # NOTE: no Paystack webhook/verification exists yet — see README "Known gaps"
